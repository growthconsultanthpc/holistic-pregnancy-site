# Copy to .env (never commit). Server-side secrets (Airtable/Resend) go in api/config.php on Hostinger, not here.
SITE_URL=http://localhost:4321
PUBLIC_NOINDEX=true            # staging: true. Production at launch: false
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=             # only if dataset is private / draft preview
PUBLIC_LEAD_ENDPOINT=/api/submit-lead.php   # local dev: http://localhost:8081/submit-lead.php
PUBLIC_SHOW_PLACEHOLDERS=true  # staging/local: true. Production: false (hides all isPlaceholder content)
