---
// About = the client's v3 page, kept as written (src/client/pages/about.html); only the founder photo and SEO come from Sanity.
import Site from '../layouts/Site.astro'
import { getSite, pic, q } from '../lib/sanity'
import raw from '../client/pages/about.html?raw'
const { settings } = await getSite()
const home = await q(`*[_id=="homePage"][0]{founderImage}`)
const a = await q(`*[_id=="aboutPage"][0]{seo, lead}`)
const img = pic(home.founderImage, [240, 360, 480], '(max-width: 860px) 200px, 360px')
const tag = img ? `<img class="fph" src="${img.src}" srcset="${img.srcset}" sizes="${img.sizes}" alt="${img.alt.replace(/"/g, '&quot;')}" width="${img.width}" height="${img.height}" fetchpriority="high" />` : ''
---
<Site title={a?.seo?.title ?? `Our Story | ${settings.businessName}`} description={a?.seo?.description ?? a?.lead}>
  <Fragment set:html={raw.replace('<!--FOUNDER_IMG-->', tag)} />
</Site>
