---
import Site from '../../layouts/Site.astro'
import LeadForm from '../../components/sections/LeadForm.astro'
import { getSite, q } from '../../lib/sanity'

export async function getStaticPaths() {
  const programs = await q(`*[_type=="program"]{title, price, meta, priceBullets, "slug": slug.current}`)
  return programs.map((p: any) => ({ params: { slug: p.slug }, props: { p } }))
}
const { p } = Astro.props
const { settings } = await getSite()
---
<Site title={`Enroll: ${p.title} | ${settings.businessName}`} minimal noindex>
  <section>
    <div class="w">
      <a class="co-back" href={`/${p.slug}/`}>← Back to {p.title}</a>
      <div class="co">
        <aside class="co-sum reveal" aria-label="Your program">
          <p class="sx-k">Your program</p>
          <h1>{p.title}</h1>
          <p style="color:var(--muted);margin:0 0 12px;font-size:14px">{p.meta} · Online</p>
          <ul class="ck">{p.priceBullets?.map((b: string) => <li>{b}</li>)}</ul>
          <div class="co-tot"><span>Total</span><b>₹{p.price.toLocaleString('en-IN')}</b></div>
          <p class="note" style="text-align:left;margin-top:10px">{settings.paymentInstructions}</p>
        </aside>
        <div class="reveal" style="--i:1">
          <h2 style="font-size:24px;margin-bottom:6px">Reserve your seat</h2>
          <p style="color:var(--muted);margin:0 0 14px">Tell us a little about you. Our team will call you to confirm your seat.</p>
          <LeadForm type="Enrol" programme={p.slug} button="Request my seat" note="Takes under a minute. We never share your information." redirect="/enroll/thank-you/" />
        </div>
      </div>
    </div>
  </section>
</Site>
