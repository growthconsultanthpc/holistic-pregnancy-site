---
import Site from '../layouts/Site.astro'
import { getSite, q, wa } from '../lib/sanity'
const { settings } = await getSite()
const c = await q(`*[_id=="communityPage"][0]`)
const join = wa(settings, c.joinMessage)
---
<Site title={c.seo?.title ?? `Community | ${settings.businessName}`} description={c.seo?.description ?? c.intro}>
  <div class="hero2 c">
    <div class="w">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.headline}</h1>
        <div class="strip center" style="margin-top:18px">{c.stages?.map((s: string) => <span>{s}</span>)}</div>
        <p class="lead" style="margin-top:18px">{c.intro}</p>
        <a class="btn btn-p" href={join} target="_blank" rel="noopener">{c.joinLabel}</a>
      </div>
    </div>
  </div>
  <section class="sx"><div class="w"><div class="t reveal"><h2>{c.whoHeading}</h2></div><p class="prose reveal" style="text-align:center">{c.who}</p></div></section>
  <section class="sx band"><div class="w"><div class="t reveal"><h2>{c.shareHeading}</h2><p>{c.shareIntro}</p></div>
    <div class="grid g4">{c.shareItems?.map((s: string, i: number) => <div class="cd mid reveal" style={`--i:${i}`}><h3>{s}</h3></div>)}</div></div></section>
  <section class="sx"><div class="w"><div class="t reveal"><h2>{c.careHeading}</h2></div>
    <ul class="ck reveal" style="max-width:560px;margin:0 auto">{c.careRules?.map((r: string) => <li>{r}</li>)}</ul></div></section>
  <section class="sx band"><div class="w" style="text-align:center"><h2 class="reveal" style="font-size:clamp(24px,3.4vw,32px);margin-bottom:18px">{c.closingHeading}</h2><a class="btn btn-p reveal" href={join} target="_blank" rel="noopener">{c.joinLabel}</a></div></section>
</Site>
