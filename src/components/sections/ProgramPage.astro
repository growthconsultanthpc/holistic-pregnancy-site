---
import Site from '../../layouts/Site.astro'
import Stats from './Stats.astro'
import Ladder from './Ladder.astro'
import ProgramNarrative from './ProgramNarrative.astro'
import Testimonials from './Testimonials.astro'
import { getSite, pic, faqLd, fill, q, showPlaceholders } from '../../lib/sanity'
import { priceHtml, priceOf } from '../../lib/offer'
const { p } = Astro.props
const { settings: s, programs, offer } = await getSite()
const now = priceOf(p.price, offer).now
const modules = import.meta.glob('../../client/programs/*.ts', { eager: true }) as Record<string, any>
const n = modules[`../../client/programs/${p.slug}.ts`]?.narrative
if (!n) throw new Error(`No narrative file for programme "${p.slug}": add src/client/programs/${p.slug}.ts`)
const reviews = await q(`*[_type=="testimonial" && visible != false && $slug in programmes && (isPlaceholder != true || $ph)]|order(_createdAt){quote, name, stage}`, { slug: p.slug, ph: showPlaceholders })
const hero = pic(p.heroImage, [480, 720, 960], '(max-width: 860px) 100vw, 520px')
const enrol = `/enroll/${p.slug}/`
const second = p.secondaryType === 'calendly' ? { href: s.calendlyUrl, ext: true } : { href: '/contact/', ext: false }
const vars = { callback: s.callbackPromise }
const faqs = (p.faqs ?? []).map((f: any) => ({ question: f.question, answer: fill(f.answer, vars) }))
const ld = [
  { '@context': 'https://schema.org', '@type': 'Course', name: p.title, description: p.heroLead, provider: { '@type': 'Organization', name: s.businessName },
    offers: { '@type': 'Offer', price: p.price, priceCurrency: 'INR', category: 'Paid' } },
  faqLd(faqs),
].filter(Boolean) as object[]
---
<Site title={p.seo?.title ?? `${p.title} | ${s.businessName}`} description={p.seo?.description ?? p.heroLead} enroll={{ slug: p.slug, price: p.price, now }} jsonld={ld}>
  <div class="hero2">
    <div class="w">
      <div class="hero-copy">
        <p class="sx-k">{p.eyebrow}</p>
        <h1>{p.heroBefore} <em>{p.heroHighlight}</em>{p.heroAfter && <> {p.heroAfter}</>}</h1>
        <p class="lead">{p.heroLead}</p>
        <div class="pr">{p.heroMeta} · <b data-m={p.price} set:html={priceHtml(p.price, offer)} /></div>
        <div class="cta">
          <a class="btn btn-p glow" href={enrol}>{p.primaryLabel}</a>
          <a class="btn btn-o" href={second.href} {...(second.ext ? { target: '_blank', rel: 'noopener' } : {})}>{p.secondaryLabel}</a>
        </div>
        <Stats s={s} variant="hero" />
      </div>
      {hero && <img class="im-hero2" src={hero.src} srcset={hero.srcset} sizes={hero.sizes} alt={hero.alt} width={hero.width} height={hero.height} fetchpriority="high" decoding="async" />}
    </div>
  </div>

  {p.inLadder && <Ladder programs={programs} current={p.slug} />}
  <ProgramNarrative n={n} p={p} s={s} offer={offer} />

  <Testimonials items={reviews} min={1} heading="Words from our mothers" />

  {faqs.length > 0 && (
    <section class="sx">
      <div class="w">
        <div class="t reveal"><h2>Questions, answered simply</h2></div>
        <div class="faq reveal">{faqs.map((f: any, i: number) => <details open={i === 0}><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div>
        <p class="disc">{s.disclaimer}</p>
      </div>
    </section>
  )}
</Site>
