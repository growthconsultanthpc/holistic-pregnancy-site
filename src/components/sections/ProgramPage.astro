---
// Programme page = the client's v3 page (src/client/pages/<slug>.html, generated by scripts/extract-v3.py) with live slots:
// hero image, ladder, testimonials and FAQs come from Sanity; every price from the offer maths (G45).
import Site from '../../layouts/Site.astro'
import Ladder from './Ladder.astro'
import Testimonials from './Testimonials.astro'
import { getSite, pic, faqLd, fill, q, showPlaceholders } from '../../lib/sanity'
import { priceHtml, priceOf } from '../../lib/offer'
const { p } = Astro.props
const { settings: s, programs, offer } = await getSite()
const frags = import.meta.glob('../../client/pages/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const raw = frags[`../../client/pages/${p.slug}.html`]
if (!raw) throw new Error(`No page fragment for programme "${p.slug}": run scripts/extract-v3.py`)
const hero = pic(p.heroImage, [480, 720, 960], '(max-width: 860px) 100vw, 520px')
const heroTag = hero ? `<img class="im-hero2" src="${hero.src}" srcset="${hero.srcset}" sizes="${hero.sizes}" alt="${hero.alt.replace(/"/g, '&quot;')}" width="${hero.width}" height="${hero.height}" fetchpriority="high" decoding="async" />` : ''
const body = raw
  .replace('<!--HERO_IMG-->', heroTag)
  .replace(/<span data-m="(\d+)"><\/span>/g, (_, n) => `<span data-m="${n}">${priceHtml(+n, offer)}</span>`)
const parts = body.split(/(<!--[A-Z_]+-->)/)
const reviews = await q(`*[_type=="testimonial" && visible != false && $slug in programmes && (isPlaceholder != true || $ph)]|order(_createdAt){quote, name, stage}`, { slug: p.slug, ph: showPlaceholders })
const vars = { callback: s.callbackPromise }
const faqs = (p.faqs ?? []).map((f: any) => ({ question: f.question, answer: fill(f.answer, vars) }))
const ld = [
  { '@context': 'https://schema.org', '@type': 'Course', name: p.title, description: p.heroLead, provider: { '@type': 'Organization', name: s.businessName },
    offers: { '@type': 'Offer', price: p.price, priceCurrency: 'INR', category: 'Paid' } },
  faqLd(faqs),
].filter(Boolean) as object[]
---
<Site title={p.seo?.title ?? `${p.title} | ${s.businessName}`} description={p.seo?.description ?? p.heroLead} enroll={{ slug: p.slug, price: p.price, now: priceOf(p.price, offer).now }} jsonld={ld}>
  {parts.map((x: string) => x === '<!--LADDER-->' ? (p.inLadder && <Ladder programs={programs} current={p.slug} />)
    : x === '<!--TESTIMONIALS-->' ? <Testimonials items={reviews} min={1} sub={`What couples share about ${p.title}`} />
    : x === '<!--FAQ-->' ? (faqs.length > 0 && (
      <section class="sx">
        <div class="w">
          <div class="t reveal"><h2>Questions, answered simply</h2></div>
          <div class="faq reveal">{faqs.map((f: any, i: number) => <details open={i === 0}><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div>
          <p class="disc">{s.disclaimer}</p>
        </div>
      </section>))
    : <Fragment set:html={x} />)}
</Site>
